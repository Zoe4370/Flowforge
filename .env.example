# Server-side only. Set one or more of these in Vercel > Project Settings > Environment Variables.
# Never prefix them with VITE_ and never commit a real key.
# Note: FlowForge also works out of the box with its built-in CSV & NLP synthesis engine if no key is set.

# Hugging Face Inference Router (recommended free/open-weights option)
HF_TOKEN=
# Optional. Defaults to Qwen/Qwen2.5-72B-Instruct
HF_MODEL=

# Google Gemini API
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash
GEMINI_MODEL=

# Optional OpenAI-compatible / Groq providers
GROQ_API_KEY=
OPENAI_API_KEY=
